      "original_lines": [
        {
          "line": 202,
          "text": "func is_visible_from_camera() -> bool:"
        },
        {
          "line": 203,
          "text": "\tvar camera := get_viewport().get_camera_3d()"
        },
        {
          "line": 204,
          "text": "\tif not is_instance_valid(camera) or not camera.is_position_in_frustum(global_position):"
        },
        {
          "line": 205,
          "text": "\t\treturn false"
        },
        {
          "line": 206,
          "text": "\tvar screen_position := camera.unproject_position(global_position)"
        },
        {
          "line": 207,
          "text": "\tvar origin := camera.project_ray_origin(screen_position)"
        },
        {
          "line": 208,
          "text": "\tvar toward_camera := (origin - global_position).normalized()"
        },
        {
          "line": 209,
          "text": "\tif not surface_normal.is_zero_approx():"
        },
        {
          "line": 210,
          "text": "\t\tvar normal := (global_basis.inverse().transposed() * surface_normal).normalized()"
        },
        {
          "line": 211,
          "text": "\t\tif normal.dot(toward_camera) < minimum_view_dot:"
        },
        {
          "line": 212,
          "text": "\t\t\treturn false"
        },
        {
          "line": 215,
          "text": "\tvar endpoint := global_position + toward_camera * 0.015"
        },
        {
          "line": 216,
          "text": "\tfor instance_id in RenderingServer.instances_cull_ray(origin, endpoint, get_world_3d().scenario):"
        },
        {
          "line": 217,
          "text": "\t\tvar mesh_node := instance_from_id(instance_id) as MeshInstance3D"
        },
        {
          "line": 230,
          "text": "\t\tvar local_from := mesh_node.to_local(origin)"
        },
        {
          "line": 231,
          "text": "\t\tvar local_to := mesh_node.to_local(endpoint)"
        },
        {
          "line": 232,
          "text": "\t\tif not triangles.intersect_segment(local_from, local_to).is_empty():"
        },
        {
          "line": 233,
          "text": "\t\t\treturn false"
        },
        {
          "line": 234,
          "text": "\treturn true"
        }
      ],
