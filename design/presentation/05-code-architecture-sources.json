      "original_lines": [
        {
          "line": 254,
          "text": "\tfor furniture_id_value: Variant in furniture.keys():"
        },
        {
          "line": 255,
          "text": "\t\tvar furniture_id := String(furniture_id_value)"
        },
        {
          "line": 256,
          "text": "\t\tvar item := furniture[furniture_id] as Dictionary"
        },
        {
          "line": 259,
          "text": "\t\tvar required_clues: Variant = item.get(\"required_clues\", [])"
        },
        {
          "line": 260,
          "text": "\t\tvar unlock_mode := String(item.get(\"unlock_mode\", \"all\"))"
        },
        {
          "line": 261,
          "text": "\t\tif not _requirements_met(required_clues, unlock_mode):"
        },
        {
          "line": 262,
          "text": "\t\t\tcontinue"
        },
        {
          "line": 263,
          "text": "\t\titem[\"is_unlocked\"] = true"
        },
        {
          "line": 264,
          "text": "\t\tfurniture[furniture_id] = item"
        },
        {
          "line": 265,
          "text": "\t\tfurniture_unlocked.emit(item.duplicate(true))"
        }
      ],
      "url": "https://github.com/rexgame103-maker/scene-calibration/blob/main/scripts/case_manager.gd#L254-L265",
