      "original_lines": [
        "\tvar item := evidence[evidence_id] as Dictionary",
        "\titem[\"is_viewed\"] = true",
        "\tevidence[evidence_id] = item",
        "\tfor clue_value: Variant in item.get(\"clue_ids\", []):",
        "\t\tvar clue_id := String(clue_value)",
        "\t\tif discover_clue(clue_id):",
        "\t\t\tdiscovered_ids.append(clue_id)",
        "\tevidence_viewed.emit(item.duplicate(true))",
        "\treturn discovered_ids"
      ],
      "display_lines": [
