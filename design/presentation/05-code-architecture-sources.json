        {
          "line": 175,
          "text": "func mark_mail_read(mail_id: String) -> void:"
        },
        {
          "line": 176,
          "text": "\tvar state := mail_state.get(mail_id, {}) as Dictionary"
        },
        {
          "line": 177,
          "text": "\tstate[\"is_read\"] = true"
        },
        {
          "line": 178,
          "text": "\tmail_state[mail_id] = state"
        },
        {
          "line": 179,
          "text": "\tmail_changed.emit()"
        },
        {
          "line": 180,
          "text": "\tsave_profile()"
        },
        {
          "line": 103,
          "text": "\tvar file := FileAccess.open(SAVE_PATH, FileAccess.WRITE)"
        },
        {
          "line": 104,
          "text": "\tif file == null:"
        },
        {
          "line": 105,
          "text": "\t\tpush_error(\"Unable to write player profile\")"
        },
        {
          "line": 106,
          "text": "\t\treturn false"
        },
        {
          "line": 107,
          "text": "\tfile.store_string(JSON.stringify(payload, \"\\t\", false))"
        },
        {
          "line": 108,
          "text": "\treturn true"
        }
      ],
