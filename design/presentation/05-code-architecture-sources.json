      "original_lines": [
        {
          "line": 105,
          "text": "func is_step_satisfied(step_id: String) -> bool:"
        },
        {
          "line": 106,
          "text": "\tif not reconstruction_steps.has(step_id):"
        },
        {
          "line": 107,
          "text": "\t\treturn false"
        },
        {
          "line": 108,
          "text": "\tvar step := reconstruction_steps[step_id] as Dictionary"
        },
        {
          "line": 109,
          "text": "\tif not are_conditions_satisfied(step.get(\"zone_ids\", [])):"
        },
        {
          "line": 110,
          "text": "\t\treturn false"
        },
        {
          "line": 111,
          "text": "\tvar required_clues: Array = step.get(\"required_clue_ids\", [])"
        },
        {
          "line": 112,
          "text": "\tif not required_clues.is_empty():"
        },
        {
          "line": 113,
          "text": "\t\tvar case_manager := _get_case_manager()"
        },
        {
          "line": 114,
          "text": "\t\tif not is_instance_valid(case_manager) or not bool(case_manager.call(\"are_clues_discovered\", required_clues)):"
        },
        {
          "line": 115,
          "text": "\t\t\treturn false"
        },
        {
          "line": 116,
          "text": "\treturn _are_lighting_conditions_satisfied(step.get(\"lighting_conditions\", []))"
        }
      ],
      "url": "https://github.com/rexgame103-maker/scene-calibration/blob/main/scripts/reconstruction_manager.gd#L105-L116",
      "display": "Tabs expanded to four spaces; common indentation removed. Explicit gaps and continuation arrows preserve original source line numbering.",
      "font_size": 13,
      "rendered_rows": 15
    },
    {
      "file": "scripts/reconstruction_manager.gd",
      "sha256": "543fb93f1d08787a96f1eb11f9d4c98a8fe39ce10988bb5265c1b970a5267d3b",
      "ranges": [
        [
          261,
