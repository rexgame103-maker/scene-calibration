        {
          "line": 72,
          "text": "func toggle_maximized() -> void:"
        },
        {
          "line": 73,
          "text": "\t_dragging = false"
        },
        {
          "line": 74,
          "text": "\tif not is_maximized:"
        },
        {
          "line": 75,
          "text": "\t\tnormal_rect = Rect2(position, size)"
        },
        {
          "line": 76,
          "text": "\tis_maximized = not is_maximized"
        },
        {
          "line": 77,
          "text": "\tfit_to_workspace()"
        },
        {
          "line": 78,
          "text": "\tmaximized_changed.emit(is_maximized)"
        },
        {
          "line": 81,
          "text": "func fit_to_workspace() -> void:"
        },
        {
          "line": 82,
          "text": "\tvar workspace_size: Vector2 = get_parent().size"
        },
        {
          "line": 83,
          "text": "\tif is_maximized:"
        },
        {
          "line": 84,
          "text": "\t\tposition = Vector2.ZERO"
        },
        {
          "line": 85,
          "text": "\t\tsize = workspace_size"
        },
        {
          "line": 86,
          "text": "\telse:"
        },
        {
          "line": 87,
          "text": "\t\tsize = normal_rect.size.min(workspace_size)"
        },
        {
          "line": 88,
          "text": "\t\tposition = _clamp_position(normal_rect.position)"
        }
      ],
