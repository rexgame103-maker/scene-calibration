      ],
      "original_lines": [
        {
          "line": 261,
          "text": "\tvar light_origin := light_device.get_light_origin()"
        },
        {
          "line": 262,
          "text": "\tvar caster_position := caster.global_position"
        },
        {
          "line": 263,
          "text": "\tvar toward_caster := (caster_position - light_origin).normalized()"
        },
        {
          "line": 264,
          "text": "\tif light_device.get_light_direction().dot(toward_caster) < float(condition.get(\"minimum_aim_dot\", 0.90)):"
        },
        {
          "line": 265,
          "text": "\t\treturn false"
        },
        {
          "line": 266,
          "text": "\tvar horizontal_distance := Vector2("
        },
        {
          "line": 267,
          "text": "\t\tcaster_position.x - light_origin.x,"
        },
        {
          "line": 268,
          "text": "\t\tcaster_position.z - light_origin.z"
        },
        {
          "line": 269,
          "text": "\t).length()"
        },
        {
          "line": 270,
          "text": "\tvar vertical_distance := maxf(0.05, light_origin.y - caster_position.y)"
        },
        {
          "line": 271,
          "text": "\tvar caster_height := maxf(0.0, caster_position.y - surface.global_position.y)"
        },
        {
          "line": 272,
          "text": "\tvar approximate_shadow_length := caster_height * horizontal_distance / vertical_distance"
        },
        {
          "line": 273,
          "text": "\treturn _value_in_range(approximate_shadow_length, condition.get(\"length_range\", [0.05, 1.5]) as Array)"
        }
      ],
      "url": "https://github.com/rexgame103-maker/scene-calibration/blob/main/scripts/reconstruction_manager.gd#L261-L273",
