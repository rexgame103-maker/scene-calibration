  "briefing": {
    "eyebrow": "警方咨询委托 · 美术馆报案",
    "title": "失准的修复室",
    "description": "一幅高价值板画在修复后出现局部发白与起伏。修复报告声称全程使用标准冷光环境，但损伤形态更像局部受热。负责修复的人否认改变过设备。",
    "instruction": "先根据年度校准照片恢复修复室的标准布局，再核对服务器保存的近距离过程照片，找出照片真正对应的设备状态。",
    "accept_button": "进入虚拟修复室",
    "accepted_status": "先打开案件资料，根据年度校准照片建立标准修复室"
  },
  "completion": {
    "required_reconstruction_step_id": "actual_restoration_layout",
    "required_clue_ids": [
      "clue_damage_alignment",
      "clue_night_access",
      "clue_report_edited"
    ],
    "failure_message": "当前布局还不能同时解释过程照片中的锐利阴影、暖色高光与二次反射，或警方补充资料尚未全部核对。",
    "title": "真实修复环境已还原",
    "description": "过程照片并非拍摄于报告所称的标准冷光环境。卤素灯与金属反光屏把热量集中在作品右下区域，位置与实际损伤完全重合。",
    "deduction": "修复师为了赶进度，违规使用发热灯具加速干燥；随后恢复标准布局并修改报告，试图把损伤伪装成材料自身异常。门禁记录、原始照片与报告修改记录形成了完整调查方向。",
    "return_button": "拍照归档并返回工作室"
  },
